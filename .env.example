# Recipient for the contact form, digits only with country code (no +, spaces or dashes).
# Example format: 15551234567 — NEVER commit a real personal number you don't have permission to publish.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public site URL used for canonical, Open Graph and sitemap URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shows small "Sample content" badges on mock stats, news, projects and community quotes.
# Set to "false" once real, verified content replaces the samples.
NEXT_PUBLIC_SHOW_PLACEHOLDER_NOTICES=true
