# Public site URL used for canonical, Open Graph, sitemap, robots and structured data.
# Production builds fall back to https://jahidkhan.com when this is empty; set it for staging or a different domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console "HTML tag" verification token (only the content value). Leave empty until you have it.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Shows small "Sample content" badges on mock stats, news, projects and community quotes.
# Set to "false" once real, verified content replaces the samples.
NEXT_PUBLIC_SHOW_PLACEHOLDER_NOTICES=true